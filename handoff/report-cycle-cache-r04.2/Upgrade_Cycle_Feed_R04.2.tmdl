		measure 'FM UI Dimensions' =
				BLANK()
			formatString: ""
			displayFolder: Forecast review\Visual feed

		measure 'FM UI Bounds' =
				VAR _scopeAllowed = CONTAINS(VALUES('fm_review_reference'[SourceRevisionID]), 'fm_review_reference'[SourceRevisionID], MINX(ALLSELECTED('fm_review_reference'), 'fm_review_reference'[SourceRevisionID])) && SELECTEDVALUE('fm_review_measures'[MetricKey]) = MINX(ALLSELECTED('fm_review_measures'), 'fm_review_measures'[MetricKey])
