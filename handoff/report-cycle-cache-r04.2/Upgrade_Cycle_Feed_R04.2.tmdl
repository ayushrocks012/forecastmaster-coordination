createOrReplace
	ref table fm_review_measures

		measure 'FM UI Numerator' =
				VAR _country = CALCULATE(SELECTEDVALUE('fm_review_reference'[Country]), ALLSELECTED('fm_review_reference'))
				VAR _cycles = CALCULATETABLE(VALUES('fm_review_reference'[DemandCycle]), ALLSELECTED('fm_review_reference'))
				VAR _selectedIDs = SELECTCOLUMNS(ALLSELECTED('fm_review_reference'), "ID", 'fm_review_reference'[SourceRevisionID])
				VAR _expectedIDs = SELECTCOLUMNS(FILTER(ALL('fm_review_reference'), 'fm_review_reference'[Country] = _country && 'fm_review_reference'[DemandCycle] IN _cycles), "ID", 'fm_review_reference'[SourceRevisionID])
				VAR _allMetrics = CALCULATE(DISTINCTCOUNT('fm_review_measures'[MetricKey]), ALLSELECTED('fm_review_measures')) = COUNTROWS(ALL('fm_review_measures'))
				VAR _cycleComplete = NOT ISBLANK(_country) && ISEMPTY(EXCEPT(_expectedIDs, _selectedIDs)) && _allMetrics
				VAR _scopeAllowed = _cycleComplete
				RETURN IF(_scopeAllowed,
				VAR _id = SELECTEDVALUE('fm_review_files'[SourceRevisionID])
				VAR _month = SELECTEDVALUE('fm_review_axis'[Month])
				VAR _key = SELECTEDVALUE('fm_review_measures'[NumeratorKey])
				VAR _allowed = CONTAINS(VALUES('fm_review_reference'[SourceRevisionID]), 'fm_review_reference'[SourceRevisionID], _id)
				RETURN IF(_allowed && NOT ISBLANK(_key) && HASONEVALUE('fm_review_measures'[MetricKey]),
				    CALCULATE(SUM('fm_review_facts'[Amount]), TREATAS({_id}, 'fm_review_facts'[SourceRevisionID]),
				        TREATAS({_month}, 'fm_review_facts'[Month]), TREATAS({_key}, 'fm_review_facts'[ComponentKey])))
				)
			formatString: 0.############
			displayFolder: Forecast review\Visual feed

		measure 'FM UI Denominator' =
				VAR _country = CALCULATE(SELECTEDVALUE('fm_review_reference'[Country]), ALLSELECTED('fm_review_reference'))
				VAR _cycles = CALCULATETABLE(VALUES('fm_review_reference'[DemandCycle]), ALLSELECTED('fm_review_reference'))
				VAR _selectedIDs = SELECTCOLUMNS(ALLSELECTED('fm_review_reference'), "ID", 'fm_review_reference'[SourceRevisionID])
				VAR _expectedIDs = SELECTCOLUMNS(FILTER(ALL('fm_review_reference'), 'fm_review_reference'[Country] = _country && 'fm_review_reference'[DemandCycle] IN _cycles), "ID", 'fm_review_reference'[SourceRevisionID])
				VAR _allMetrics = CALCULATE(DISTINCTCOUNT('fm_review_measures'[MetricKey]), ALLSELECTED('fm_review_measures')) = COUNTROWS(ALL('fm_review_measures'))
				VAR _cycleComplete = NOT ISBLANK(_country) && ISEMPTY(EXCEPT(_expectedIDs, _selectedIDs)) && _allMetrics
				VAR _scopeAllowed = _cycleComplete
				RETURN IF(_scopeAllowed,
				VAR _id = SELECTEDVALUE('fm_review_files'[SourceRevisionID])
				VAR _month = SELECTEDVALUE('fm_review_axis'[Month])
				VAR _key = SELECTEDVALUE('fm_review_measures'[DenominatorKey])
				VAR _allowed = CONTAINS(VALUES('fm_review_reference'[SourceRevisionID]), 'fm_review_reference'[SourceRevisionID], _id)
				RETURN IF(_allowed && NOT ISBLANK(_key) && HASONEVALUE('fm_review_measures'[MetricKey]),
				    CALCULATE(SUM('fm_review_facts'[Amount]), TREATAS({_id}, 'fm_review_facts'[SourceRevisionID]),
				        TREATAS({_month}, 'fm_review_facts'[Month]), TREATAS({_key}, 'fm_review_facts'[ComponentKey])))
				)
			formatString: 0.############
			displayFolder: Forecast review\Visual feed

		measure 'FM UI Numerator Missing' =
				VAR _country = CALCULATE(SELECTEDVALUE('fm_review_reference'[Country]), ALLSELECTED('fm_review_reference'))
				VAR _cycles = CALCULATETABLE(VALUES('fm_review_reference'[DemandCycle]), ALLSELECTED('fm_review_reference'))
				VAR _selectedIDs = SELECTCOLUMNS(ALLSELECTED('fm_review_reference'), "ID", 'fm_review_reference'[SourceRevisionID])
				VAR _expectedIDs = SELECTCOLUMNS(FILTER(ALL('fm_review_reference'), 'fm_review_reference'[Country] = _country && 'fm_review_reference'[DemandCycle] IN _cycles), "ID", 'fm_review_reference'[SourceRevisionID])
				VAR _allMetrics = CALCULATE(DISTINCTCOUNT('fm_review_measures'[MetricKey]), ALLSELECTED('fm_review_measures')) = COUNTROWS(ALL('fm_review_measures'))
				VAR _cycleComplete = NOT ISBLANK(_country) && ISEMPTY(EXCEPT(_expectedIDs, _selectedIDs)) && _allMetrics
				VAR _scopeAllowed = _cycleComplete
				RETURN IF(_scopeAllowed,
				VAR _id = SELECTEDVALUE('fm_review_files'[SourceRevisionID])
				VAR _month = SELECTEDVALUE('fm_review_axis'[Month])
				VAR _key = SELECTEDVALUE('fm_review_measures'[NumeratorKey])
				VAR _allowed = CONTAINS(VALUES('fm_review_reference'[SourceRevisionID]), 'fm_review_reference'[SourceRevisionID], _id)
				RETURN IF(_allowed && NOT ISBLANK(_key) && HASONEVALUE('fm_review_measures'[MetricKey]),
				    CALCULATE(SUM('fm_review_facts'[MissingCells]), TREATAS({_id}, 'fm_review_facts'[SourceRevisionID]),
				        TREATAS({_month}, 'fm_review_facts'[Month]), TREATAS({_key}, 'fm_review_facts'[ComponentKey])))
				)
			formatString: 0.############
			displayFolder: Forecast review\Visual feed

		measure 'FM UI Denominator Missing' =
				VAR _country = CALCULATE(SELECTEDVALUE('fm_review_reference'[Country]), ALLSELECTED('fm_review_reference'))
				VAR _cycles = CALCULATETABLE(VALUES('fm_review_reference'[DemandCycle]), ALLSELECTED('fm_review_reference'))
				VAR _selectedIDs = SELECTCOLUMNS(ALLSELECTED('fm_review_reference'), "ID", 'fm_review_reference'[SourceRevisionID])
				VAR _expectedIDs = SELECTCOLUMNS(FILTER(ALL('fm_review_reference'), 'fm_review_reference'[Country] = _country && 'fm_review_reference'[DemandCycle] IN _cycles), "ID", 'fm_review_reference'[SourceRevisionID])
				VAR _allMetrics = CALCULATE(DISTINCTCOUNT('fm_review_measures'[MetricKey]), ALLSELECTED('fm_review_measures')) = COUNTROWS(ALL('fm_review_measures'))
				VAR _cycleComplete = NOT ISBLANK(_country) && ISEMPTY(EXCEPT(_expectedIDs, _selectedIDs)) && _allMetrics
				VAR _scopeAllowed = _cycleComplete
				RETURN IF(_scopeAllowed,
				VAR _id = SELECTEDVALUE('fm_review_files'[SourceRevisionID])
				VAR _month = SELECTEDVALUE('fm_review_axis'[Month])
				VAR _key = SELECTEDVALUE('fm_review_measures'[DenominatorKey])
				VAR _allowed = CONTAINS(VALUES('fm_review_reference'[SourceRevisionID]), 'fm_review_reference'[SourceRevisionID], _id)
				RETURN IF(_allowed && NOT ISBLANK(_key) && HASONEVALUE('fm_review_measures'[MetricKey]),
				    CALCULATE(SUM('fm_review_facts'[MissingCells]), TREATAS({_id}, 'fm_review_facts'[SourceRevisionID]),
				        TREATAS({_month}, 'fm_review_facts'[Month]), TREATAS({_key}, 'fm_review_facts'[ComponentKey])))
				)
			formatString: 0.############
			displayFolder: Forecast review\Visual feed

		measure 'FM UI File' =
				VAR _scopeAllowed = CONTAINS(VALUES('fm_review_reference'[SourceRevisionID]), 'fm_review_reference'[SourceRevisionID], MINX(ALLSELECTED('fm_review_reference'), 'fm_review_reference'[SourceRevisionID])) && SELECTEDVALUE('fm_review_measures'[MetricKey]) = MINX(ALLSELECTED('fm_review_measures'), 'fm_review_measures'[MetricKey])
				RETURN IF(_scopeAllowed,
				VAR _month = SELECTEDVALUE('fm_review_axis'[Month])
				VAR _first = MINX(ALL('fm_review_axis'), 'fm_review_axis'[Month])
				RETURN IF(_month = _first, "{" & """id"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(SELECTEDVALUE('fm_review_files'[SourceRevisionID]), ""), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """fullLabel"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(SELECTEDVALUE('fm_review_files'[FileLabel]), ""), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """filename"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(SELECTEDVALUE('fm_review_files'[SourceFileName]), ""), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """path"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(SELECTEDVALUE('fm_review_files'[SourceRelativePath]), ""), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """affiliate"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(SELECTEDVALUE('fm_review_files'[Country]), ""), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """cycle"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(SELECTEDVALUE('fm_review_files'[DemandCycle]), ""), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """driver"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(SELECTEDVALUE('fm_review_files'[GrowthDriver]), ""), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """profile"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(SELECTEDVALUE('fm_review_files'[SourceProfile]), ""), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """status"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(SELECTEDVALUE('fm_review_files'[PublicationStatus]), ""), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """ims"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(FORMAT(SELECTEDVALUE('fm_review_files'[IMSActualsThrough]), "yyyy-MM"), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """ef"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(FORMAT(SELECTEDVALUE('fm_review_files'[ExFactoryActualsThrough]), "yyyy-MM"), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "}")
				)
			formatString: ""
			displayFolder: Forecast review\Visual feed

		measure 'FM UI Catalog' =
				VAR _scopeAllowed = CONTAINS(VALUES('fm_review_reference'[SourceRevisionID]), 'fm_review_reference'[SourceRevisionID], MINX(ALLSELECTED('fm_review_reference'), 'fm_review_reference'[SourceRevisionID])) && SELECTEDVALUE('fm_review_measures'[MetricKey]) = MINX(ALLSELECTED('fm_review_measures'), 'fm_review_measures'[MetricKey])
				RETURN IF(_scopeAllowed,
				VAR _firstMonth = MINX(ALL('fm_review_axis'), 'fm_review_axis'[Month])
				VAR _firstFile = MINX(ALL('fm_review_files'), 'fm_review_files'[SourceRevisionID])
				VAR _first = SELECTEDVALUE('fm_review_axis'[Month]) = _firstMonth && SELECTEDVALUE('fm_review_files'[SourceRevisionID]) = _firstFile

				RETURN IF(_first, "[" & CONCATENATEX(ALL('fm_review_measures'), "{" & """id"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE('fm_review_measures'[MetricKey], UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """family"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE('fm_review_measures'[Section], UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """label"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE('fm_review_measures'[Measure], UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """unit"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE('fm_review_measures'[Unit], UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """aggregation"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE('fm_review_measures'[Aggregation], UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """cutoffFamily"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE('fm_review_measures'[CutoffFamily], UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """numeratorKey"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE('fm_review_measures'[NumeratorKey], UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """denominatorKey"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE('fm_review_measures'[DenominatorKey], UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """availabilityIndex"":" & FORMAT(RANKX(ALL('fm_review_measures'), 'fm_review_measures'[MetricKey], , ASC, DENSE) - 1, "0") & "}", ",", 'fm_review_measures'[SortIndex], ASC) & "]")
				)
			formatString: ""
			displayFolder: Forecast review\Visual feed

		measure 'FM UI Context' =
				VAR _country = CALCULATE(SELECTEDVALUE('fm_review_reference'[Country]), ALLSELECTED('fm_review_reference'))
				VAR _cycles = CALCULATETABLE(VALUES('fm_review_reference'[DemandCycle]), ALLSELECTED('fm_review_reference'))
				VAR _selectedIDs = SELECTCOLUMNS(ALLSELECTED('fm_review_reference'), "ID", 'fm_review_reference'[SourceRevisionID])
				VAR _expectedIDs = SELECTCOLUMNS(FILTER(ALL('fm_review_reference'), 'fm_review_reference'[Country] = _country && 'fm_review_reference'[DemandCycle] IN _cycles), "ID", 'fm_review_reference'[SourceRevisionID])
				VAR _allMetrics = CALCULATE(DISTINCTCOUNT('fm_review_measures'[MetricKey]), ALLSELECTED('fm_review_measures')) = COUNTROWS(ALL('fm_review_measures'))
				VAR _cycleComplete = NOT ISBLANK(_country) && ISEMPTY(EXCEPT(_expectedIDs, _selectedIDs)) && _allMetrics
				VAR _scopeAllowed = CONTAINS(VALUES('fm_review_reference'[SourceRevisionID]), 'fm_review_reference'[SourceRevisionID], MINX(ALLSELECTED('fm_review_reference'), 'fm_review_reference'[SourceRevisionID])) && SELECTEDVALUE('fm_review_measures'[MetricKey]) = MINX(ALLSELECTED('fm_review_measures'), 'fm_review_measures'[MetricKey])
				RETURN IF(_scopeAllowed,
				VAR _firstMonth = MINX(ALL('fm_review_axis'), 'fm_review_axis'[Month])
				VAR _firstFile = MINX(ALL('fm_review_files'), 'fm_review_files'[SourceRevisionID])
				VAR _first = SELECTEDVALUE('fm_review_axis'[Month]) = _firstMonth && SELECTEDVALUE('fm_review_files'[SourceRevisionID]) = _firstFile

				RETURN IF(_first, "{" & """affiliate"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(CALCULATE(SELECTEDVALUE('fm_review_reference'[Country], ""), ALLSELECTED('fm_review_reference')), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """profile"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(CALCULATE(SELECTEDVALUE('fm_review_reference'[SourceProfile], ""), ALLSELECTED('fm_review_reference')), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """metric"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(CALCULATE(SELECTEDVALUE('fm_review_measures'[MetricKey], ""), ALLSELECTED('fm_review_measures')), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """channel"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISFILTERED('fm_review_facts'[Channel]), SELECTEDVALUE('fm_review_facts'[Channel], "all"), "all"), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """subchannel"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISFILTERED('fm_review_facts'[SubChannel]), SELECTEDVALUE('fm_review_facts'[SubChannel], "all"), "all"), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """sector"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISFILTERED('fm_review_facts'[Sector]), SELECTEDVALUE('fm_review_facts'[Sector], "all"), "all"), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """schema"":" & "5" & "," & """complete"":" & IF(_cycleComplete, "true", "false") & "," & """cycle"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(CALCULATE(SELECTEDVALUE('fm_review_reference'[DemandCycle], ""), ALLSELECTED('fm_review_reference')), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """driver"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(CALCULATE(SELECTEDVALUE('fm_review_reference'[GrowthDriver], ""), ALLSELECTED('fm_review_reference')), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """cycles"":" & "[" & CONCATENATEX(SUMMARIZE(ALLSELECTED('fm_review_reference'), 'fm_review_reference'[DemandCycle]), UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE('fm_review_reference'[DemandCycle], UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34), ",", 'fm_review_reference'[DemandCycle], ASC) & "]" & "," & """drivers"":" & "[" & CONCATENATEX(SUMMARIZE(ALLSELECTED('fm_review_reference'), 'fm_review_reference'[GrowthDriver]), UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE('fm_review_reference'[GrowthDriver], UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34), ",", 'fm_review_reference'[GrowthDriver], ASC) & "]" & "}")
				)
