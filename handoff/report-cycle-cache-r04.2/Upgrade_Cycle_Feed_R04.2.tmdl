				VAR _firstFile = MINX(ALL('fm_review_files'), 'fm_review_files'[SourceRevisionID])
				VAR _first = SELECTEDVALUE('fm_review_axis'[Month]) = _firstMonth && SELECTEDVALUE('fm_review_files'[SourceRevisionID]) = _firstFile
				RETURN IF(_first, "{" & """first"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(FORMAT(MINX(ALL('fm_review_axis'), 'fm_review_axis'[Month]), "yyyy-MM"), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "," & """last"":" & UNICHAR(34) & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(FORMAT(MAXX(ALL('fm_review_axis'), 'fm_review_axis'[Month]), "yyyy-MM"), UNICHAR(92), UNICHAR(92) & UNICHAR(92)), UNICHAR(34), UNICHAR(92) & UNICHAR(34)), UNICHAR(13), ""), UNICHAR(10), UNICHAR(92) & "n"), UNICHAR(9), UNICHAR(92) & "t") & UNICHAR(34) & "}")
				)
